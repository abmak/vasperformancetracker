# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=vas_revenue_tracking
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Gemini AI models to try, in order. A model that answers 503 "high demand" is
# skipped in favour of the next one, so listing a few flash models keeps the AI
# assistant answering during demand spikes on any single model.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest

# Gemini AI API Keys (round-robin pool for rate-limit handling)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5
