# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=vas_revenue_tracking
DB_PORT=3306

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Gemini AI models to try, in order. 503 "high demand" answers are transient
# and per request, so each request retries down this chain with a short pause
# between attempts — listing several flash models keeps the assistant answering
# during demand spikes. Only models enabled for your API keys belong here
# (gemini-2.5-* and the *-lite models 404 on some projects).
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3-flash-preview,gemini-3.1-flash-lite-preview,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-latest

# Attempts per question before giving up (each attempt pauses briefly first).
AI_MAX_ATTEMPTS=8

# Gemini AI API Keys (round-robin pool for rate-limit handling)
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5
